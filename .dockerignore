# Files / directories that should NOT be in the Docker build
# context. Keeping the build context small speeds up `docker build`
# and avoids accidentally baking secrets into the image.

# Git
.git
.gitignore

# Editor / OS
.vscode
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build output
.next
out
build
dist
coverage
.turbo

# Dependencies (rebuilt in the deps stage)
node_modules

# Env files (NEVER bake secrets into the image)
.env
.env.local
.env.*.local
.env.production

# Tests
tests
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
vitest.config.ts

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Audit / cli's
.agents
.claude
