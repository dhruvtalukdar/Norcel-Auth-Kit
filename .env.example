# ─────────────────────────────────────────────────────────────────────────────
# ForgeStack — Environment Variables (example)
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Database (Supabase Postgres / any Postgres URL)
# Supabase: Project Settings → Database → Connection string → Transaction mode
DATABASE_URL="postgresql://user:password@host:5432/forgestack?schema=public"
# Supabase direct (used by Prisma migrate; IPv4-friendly pooler)
DIRECT_URL="postgresql://user:password@host:5432/forgestack?schema=public"

# Auth.js (NextAuth v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-32-byte-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email (magic link + verification + password reset)
# Provider: "resend" | "smtp" | "console" (dev — logs links to terminal)
EMAIL_PROVIDER="console"
EMAIL_FROM="ForgeStack <no-reply@forgestack.dev>"

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=""

# SMTP (fallback / non-Resend deployments)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# App
NEXT_PUBLIC_APP_NAME="ForgeStack"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
