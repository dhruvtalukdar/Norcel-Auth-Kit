# ─────────────────────────────────────────────────────────────────────────────
# Norcel — Environment Variables (example)
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Database (Supabase Postgres / any Postgres URL)
#
# We recommend going through Supabase's transaction-mode pooler
# (port 6543) for production reliability — the direct endpoint
# (port 5432) on the free tier is paused after inactivity. On a
# paid plan or self-hosted Postgres you can use port 5432 directly.
#
# Required query params:
#   ?pgbouncer=true           — Prisma unprepared-statement protocol
#   ?connection_limit=N       — pooler connection count per Prisma client
#   ?connect_timeout=15       — fail fast on dead connections
#
# Supabase example:
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=15"
# For migrations, use a connection that supports DDL. Supabase's
# free-tier transaction pooler (port 6543) blocks DDL, and the
# direct endpoint (port 5432) is often paused. Options:
#   1. Supabase paid plan: the direct endpoint (port 5432) is enabled.
#   2. Local Postgres: spin up `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16`.
#   3. Hosted Postgres (Neon, Supabase, RDS, etc.) with a public direct URL.
#
# Uncomment the appropriate value for DIRECT_URL:
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/norcel"   # local Docker
# DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres"  # Supabase direct
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/norcel"

# Auth.js (NextAuth v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-32-byte-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email (magic link + verification + password reset)
# Provider: "resend" | "smtp" | "console" (dev — logs links to terminal)
EMAIL_PROVIDER="console"
EMAIL_FROM="Norcel <contact@norcel.dev>"

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=""

# SMTP (fallback / non-Resend deployments)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# App
NEXT_PUBLIC_APP_NAME="Norcel"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
