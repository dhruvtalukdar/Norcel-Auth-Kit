// Norcel — Prisma schema
// Database: Supabase Postgres
// ORM: Prisma 5
//
// Models: User, Role, Session, VerificationToken, PasswordResetToken, Account
// Auth.js (NextAuth v5) requires the Account / Session / VerificationToken shapes.
// Norcel also extends User with passwordHash + roleId for credentials login + RBAC,
// plus pre-Phase-2 hardening: SUPER_ADMIN role, LoginAttempt rate-limit, SecurityEvent
// audit log, UserSession server-side session list, soft-delete on User.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGIN_LOCKED
  LOGOUT
  SIGNUP
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
  EMAIL_CHANGE_REQUESTED
  EMAIL_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  OAUTH_LINKED
  OAUTH_UNLINKED
  MAGIC_LINK_REQUESTED
  MAGIC_LINK_CONSUMED
  SESSION_REVOKED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  ACCOUNT_DELETED
  ACCOUNT_RESTORED
  ROLE_CHANGED
}

enum LoginAttemptStatus {
  SUCCESS
  FAILURE
  LOCKED
}

// ─── Roles (RBAC) ─────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        UserRole @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Users ────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?

  // Pending email change. The user requests a change, we set
  // `pendingEmail` + send a verification link to the new address. On
  // confirmation we promote it to `email`. `pendingEmail` is a separate
  // unique field so two users can't race to claim the same new address
  // during the verification window.
  pendingEmail        String?   @unique
  pendingEmailTokenId String?   @unique
  pendingEmailExpires DateTime?

  // Role relation (FK)
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Auth.js relations
  accounts Account[]

  // Norcel relations
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  magicLinkTokens          MagicLinkToken[]
  emailChangeTokens        EmailChangeToken[]
  userSessions             UserSession[]
  loginAttempts            LoginAttempt[]
  securityEvents           SecurityEvent[]

  // Lockout
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // Soft delete
  deletedAt DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([roleId])
  @@index([deletedAt])
}

// ─── Auth.js (NextAuth v5) — required adapter models ───────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Note: Auth.js's `Session` model is omitted. We use the JWT session
// strategy, which doesn't write to this table. Our own `UserSession`
// model (below) is what the user can see and revoke.

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Norcel — Password reset, email change, server-side sessions ──────

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Email verification tokens (separate from Auth.js's VerificationToken
// table, which is reserved for the adapter). Stored as SHA-256
// fingerprints so a DB compromise yields only hashed values that
// can't be replayed.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Magic-link tokens (passwordless sign-in). Hashed at rest, like
// PasswordResetToken and EmailVerificationToken.
model MagicLinkToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailChangeToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  newEmail  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Server-side session list. Auth.js's `Session` table is populated only by
// the database session strategy — with our JWT strategy, sessions live in
// cookies. We mirror each sign-in here so the user can see and revoke
// active sessions from /settings/sessions. `sessionId` is a random opaque
// ID that we put in the JWT; when the user revokes a session we delete
// the row and (next time the JWT is checked) the guard sees the missing
// row and forces a re-auth.
model UserSession {
  id         String    @id @default(cuid())
  sessionId  String    @unique
  userId     String
  userAgent  String?   @db.Text
  ip         String?
  city       String?
  country    String?
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Security — login attempts + audit log ───────────────────────────────

// Per-login-attempt record. Used for rate limiting and lockout. Indexed
// on (email, createdAt) so we can quickly ask "how many failed attempts
// has this email had in the last 15 minutes?".
model LoginAttempt {
  id        String            @id @default(cuid())
  email     String
  userId    String?
  status    LoginAttemptStatus
  ip        String?
  userAgent String?           @db.Text
  createdAt DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([userId])
  @@index([createdAt])
}

// Append-only audit log of security-relevant events. Surfaces in the
// admin dashboard so security teams can answer "who logged in last
// Tuesday at 3am?" and "did anyone change the role on this account?".
model SecurityEvent {
  id        String            @id @default(cuid())
  type      SecurityEventType
  userId    String?
  // Email at the time of the event (denormalised so we can render the
  // event even after the user is deleted).
  email     String?
  ip        String?
  userAgent String?           @db.Text
  metadata  Json?
  createdAt DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}
